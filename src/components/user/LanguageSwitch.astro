---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Icon from './Icon.astro'

// 获取当前语言
const currentLocale = Astro.currentLocale || 'zh'

// 定义语言映射
const languages = {
  zh: '中文',
  en: 'English',
  ja: '日本語'
} as const

type Locale = keyof typeof languages
const order: Locale[] = ['zh', 'en', 'ja']
const valid = order as string[]

// 类型安全的当前语言
const safeCurrentLocale = valid.includes(currentLocale) ? (currentLocale as Locale) : 'zh'

// 循环切换目标：zh → en → ja → zh
const targetLocale = order[(order.indexOf(safeCurrentLocale) + 1) % order.length]

// 当前页面路径：先剥离子路径 base（如 /Yuu），得到 base 相对路径
const baseURL = import.meta.env.BASE_URL.replace(/\/$/, '') // '/Yuu'
const currentPath = Astro.url.pathname
let pagePath = currentPath.startsWith(baseURL)
  ? currentPath.slice(baseURL.length) || '/'
  : currentPath

// 再剥离当前语言前缀（/en、/ja）
for (const loc of ['en', 'ja']) {
  if (safeCurrentLocale === loc) {
    if (pagePath === `/${loc}`) {
      pagePath = '/'
    } else if (pagePath.startsWith(`/${loc}/`)) {
      pagePath = pagePath.slice(loc.length + 1) || '/'
    }
  }
}

// 生成目标语言的 URL
let targetUrl = getRelativeLocaleUrl(targetLocale, pagePath)

// 处理 trailingSlash: 'never' 配置
// 移除尾部斜杠（除了根路径 /）
if (targetUrl !== '/' && targetUrl.endsWith('/')) {
  targetUrl = targetUrl.slice(0, -1)
}

// 目标语言首页（当目标页面不存在翻译时的回退地址）
const fallbackUrl = getRelativeLocaleUrl(targetLocale, '/').replace(/\/$/, '') || '/'
---

<button
  id="language-switch-btn"
  class="box-content rounded-md border p-1.5 transition-colors hover:bg-border md:group-[.not-top]:rounded-xl"
  title={`切换到${languages[targetLocale]}`}
  data-target-url={targetUrl}
  data-fallback-url={fallbackUrl}
>
  <span class="sr-only">{`切换到${languages[targetLocale]}`}</span>
  <div class="flex items-center gap-1">
    <Icon name="earth" class="size-4" />
    <span class="text-xs font-medium">{languages[safeCurrentLocale]}</span>
  </div>
</button>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const switchBtn = document.getElementById('language-switch-btn') as HTMLButtonElement

    if (switchBtn) {
      switchBtn.addEventListener('click', async () => {
        const targetUrl = switchBtn.dataset.targetUrl
        const fallbackUrl = switchBtn.dataset.fallbackUrl
        if (!targetUrl) return
        try {
          // 目标页面若无对应翻译（404），回退到目标语言首页
          const res = await fetch(targetUrl, { method: 'HEAD' })
          window.location.href = res.ok ? targetUrl : fallbackUrl || '/'
        } catch {
          window.location.href = targetUrl
        }
      })
    }
  })
</script>
