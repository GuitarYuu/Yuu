---
import PageLayout from '@/layouts/CommonPage.astro'
import { Spoiler } from '@/components/user'
import { Comment } from '@/components/advanced'

const headings = [
  { depth: 2, slug: 'intro', text: 'About Me' },
  { depth: 2, slug: 'favorites', text: 'Favorites' },
  { depth: 2, slug: 'site', text: 'About This Site' }
]
---

<PageLayout title='About' {headings} info='/en/about'>
  <h2 id='intro'>About Me<a class='anchor' href='#intro'>#</a></h2>
  <p>I'm Yuu — a second-year student at Yagen East Academy, a member of the student council, and a part-timer at a bookstore. After school you'll find me in either the library or the shop.</p>
  <p>My special skill is spending an entire afternoon in the library. My latest achievement: ranking every book on my library card by "favoritism".</p>
  <p>My catchphrase is "a-anyway, let me write that down". <Spoiler>Truth be told, nothing absorbs me like writing a story.</Spoiler></p>

  <h2 id='favorites'>Favorites<a class='anchor' href='#favorites'>#</a></h2>
  <ul>
    <li>The sound of rain, wooden library desks, pudding (especially the burnt caramel part)</li>
    <li>Shoujo novels, and daydreaming about "the next story"</li>
    <li>The bookstore at dusk, and the last customer before closing</li>
  </ul>

  <h2 id='site'>About This Site<a class='anchor' href='#site'>#</a></h2>
  <p>This is my little corner: records of books I've read, half-finished stories, and everyday life at the academy.</p>
  <p>Everything here is fiction. The site's colors are pink, blue and white — a little homage to the work that taught me: even feelings you cannot name have a shape of their own.</p>
  <Comment slot='bottom' />
</PageLayout>
